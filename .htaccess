# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# =====================================================================
#  Минибагер Костинброд — статичен сайт (Apache / LiteSpeed / cPanel)
# =====================================================================

DirectoryIndex index.html index.php
Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
#  Каноничен адрес: HTTPS + без www
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # mail.* → apex (поддомейнът сочи към същия docroot)
  RewriteCond %{HTTP_HOST} ^mail\.minibagerkb\.eu$ [NC]
  RewriteRule ^ https://minibagerkb.eu/ [L,R=301]

  # www → без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Сурови телефонни JPG — не се сервират
  RewriteRule ^assets/img/%D0%BD%D0%BE%D0%B2%D0%B8/ - [F,L]

  # Sitemap: статичен .xml не се взима от Googlebot на BinHost → PHP обход
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ---------------------------------------------------------------------
#  MIME типове
#  Sitemap: application/xml (GSC понякога отхвърля text/xml на LiteSpeed/cPanel).
#  Не пипаме Content-Type с Header set — конфликт с AddCharset чупи HTML за GSC.
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                .webp
  AddType image/svg+xml             .svg
  AddType font/woff2                .woff2
  AddType application/manifest+json .webmanifest
  AddType image/x-icon              .ico
  AddType application/xml           .xml
  AddType text/plain                .txt

  AddCharset UTF-8 .html .css .js .txt .json .webmanifest .svg
</IfModule>

# ---------------------------------------------------------------------
#  Компресия
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------
#  Кеширане
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css        "access plus 1 year"
  ExpiresByType font/woff2      "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp      "access plus 30 days"
  ExpiresByType image/png       "access plus 30 days"
  ExpiresByType image/jpeg      "access plus 30 days"
  ExpiresByType image/x-icon    "access plus 30 days"
  ExpiresByType image/svg+xml   "access plus 30 days"
  ExpiresByType text/html       "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain      "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|woff2|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(sitemap\.(xml|txt|php)|robots\.txt|llms(-full)?\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
#  Сигурност
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ---------------------------------------------------------------------
#  Служебни файлове — без достъп
# ---------------------------------------------------------------------
<FilesMatch "(^\.|\.(bak|config|dist|inc|ini|log|sh|sql|zip|py)$|^_redirects$)">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>
